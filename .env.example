# API Go (punto de entrada público)
PORT=8080
NODE_API_URL=http://localhost:3000

# JWT (demo local; cambiar en cloud)
JWT_SECRET=dev-only-change-me-please
JWT_USERNAME=admin
JWT_PASSWORD=admin
JWT_TTL=1h

# API Node (operación adicional; en Docker usar http://node-api:3000)
NODE_PORT=3000

# Frontend local (Vite). En Docker nginx hace proxy y no hace falta CORS.
CORS_ORIGINS=http://localhost:5173

